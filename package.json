{
    "name": "oh-my-tabs",
    "version": "1.0.0",
    "description": "A playful, jelly-like animated tab bar for React Native.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "react-native": "./src/index.ts",
    "exports": {
        ".": {
            "react-native": "./src/index.ts",
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            },
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit",
        "example": "bun run --cwd example start",
        "example:android": "bun run --cwd example android",
        "example:ios": "bun run --cwd example ios",
        "example:web": "bun run --cwd example web",
        "prepublishOnly": "bun run build",
        "era": "cd example && bunx expo run android",
        "epc": "cd example && bunx expo prebuild --clean"
    },
    "peerDependencies": {
        "@react-native-masked-view/masked-view": ">=0.3.0",
        "react": ">=18.0.0",
        "react-native": ">=0.76.0",
        "react-native-gesture-handler": ">=2.20.0",
        "react-native-reanimated": ">=3.16.0",
        "react-native-svg": ">=15.0.0"
    },
    "devDependencies": {
        "@react-native-masked-view/masked-view": "^0.3.2",
        "@types/react": "~19.2.2",
        "react": "19.2.3",
        "react-native": "0.86.2",
        "react-native-gesture-handler": "^3.1.0",
        "react-native-reanimated": "4.5.1",
        "react-native-svg": "15.15.4",
        "tsdown": "^0.22.14",
        "typescript": "~6.0.3"
    },
    "workspaces": [
        "example"
    ],
    "engines": {
        "node": ">=18"
    },
    "license": "MIT",
    "private": false,
    "packageManager": "bun@1.3.14"
}
